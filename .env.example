HOST=127.0.0.1
PORT=3000

# Fastmail SMTP — use a Fastmail app-specific password, not your normal password.
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thomas@zl3tom.com
SMTP_PASS=
CONTACT_TO=thomas@zl3tom.com
CONTACT_FROM=thomas@zl3tom.com

# Cloudflare Turnstile — create a Managed widget for zl3tom.com and www.zl3tom.com.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=zl3tom.com,www.zl3tom.com

# Simple per-IP protection in addition to Turnstile.
CONTACT_MAX_PER_HOUR=5
